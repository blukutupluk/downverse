#!/data/data/com.termux/files/usr/bin/bash
# OpenCode Usage Monitor — alternatif ccusage (tanpa Node.js)
# Query langsung dari ~/.local/share/opencode/opencode.db

DB="$HOME/.local/share/opencode/opencode.db"

if [[ ! -f "$DB" ]]; then
  echo "Database tidak ditemukan: $DB"
  exit 1
fi

echo "=== OpenCode Usage Summary ==="
echo ""

python3 - "$DB" << 'PYEOF'
import sqlite3, sys, datetime

db = sys.argv[1]
conn = sqlite3.connect(db)

# Total sessions
total_sessions = conn.execute("SELECT COUNT(*) FROM session_v2").fetchone()[0]
print(f"Total sessions: {total_sessions}")

# Total tokens & cost
row = conn.execute("""
    SELECT 
        COALESCE(SUM(tokens_input), 0),
        COALESCE(SUM(tokens_output), 0),
        COALESCE(SUM(tokens_reasoning), 0),
        COALESCE(SUM(tokens_cache_read), 0),
        COALESCE(SUM(tokens_cache_write), 0),
        COALESCE(SUM(cost), 0)
    FROM session_v2
""").fetchone()

ti, to, tr, tcr, tcw, cost = row
total_tokens = ti + to + tr + tcr + tcw
print(f"Tokens input:    {ti:,}")
print(f"Tokens output:   {to:,}")
print(f"Tokens reasoning:{tr:,}")
print(f"Tokens cache rd: {tcr:,}")
print(f"Tokens cache wr: {tcw:,}")
print(f"Total tokens:    {total_tokens:,}")
print(f"Total cost (USD): ${cost:.4f}")
print("")

# By model
print("=== By Model ===")
import json as _json
models = conn.execute("""
    SELECT model, COUNT(*) as cnt, 
           COALESCE(SUM(tokens_input),0) + COALESCE(SUM(tokens_output),0) + 
           COALESCE(SUM(tokens_reasoning),0) + COALESCE(SUM(tokens_cache_read),0) + 
           COALESCE(SUM(tokens_cache_write),0) as total_tok,
           COALESCE(SUM(cost),0) as total_cost
    FROM session_v2
    WHERE model IS NOT NULL
    GROUP BY model
    ORDER BY total_tok DESC
""").fetchall()

for m in models:
    try:
        model_obj = _json.loads(m[0])
        model_name = f"{model_obj.get('providerID','?')}/{model_obj.get('id','?')}"
    except:
        model_name = m[0][:50]
    print(f"  {model_name}: {m[1]} sessions, {m[2]:,} tokens, ${m[3]:.4f}")

print("")
print("=== Recent Sessions (last 10) ===")
sessions = conn.execute("""
    SELECT title, model, tokens_input, tokens_output, cost, 
           datetime(time_created/1000, 'unixepoch', 'localtime') as created
    FROM session_v2
    ORDER BY time_created DESC
    LIMIT 10
""").fetchall()

for s in sessions:
    title = (s[0] or "(untitled)")[:40]
    try:
        model_obj = _json.loads(s[1]) if s[1] else {}
        model = f"{model_obj.get('providerID','?')}/{model_obj.get('id','?')}" if model_obj else "unknown"
    except:
        model = (s[1] or "unknown")[:30]
    ti = s[2] or 0
    to = s[3] or 0
    cost = s[4] or 0
    created = s[5] or ""
    print(f"  {created} | {model} | in={ti:,} out={to:,} | ${cost:.4f} | {title}")

conn.close()
PYEOF